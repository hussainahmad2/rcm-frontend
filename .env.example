# Browser API prefix. Keep this as /api in local dev so Vite can proxy to Nest
# on the same origin. The refresh cookie is scoped to path=/api/auth.
#
# Auth routes (all relative to VITE_API_BASE):
#   POST /auth/login
#   POST /auth/refresh
#   POST /auth/logout
#   GET  /auth/me
#   GET  /auth/session-policy
VITE_API_BASE=/api

# Nest backend origin used by the Vite /api proxy (not called from the browser).
VITE_BACKEND_ORIGIN=http://127.0.0.1:3001
